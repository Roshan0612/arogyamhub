# Keep false for the private concept. Set true only after owner approval.
NEXT_PUBLIC_SITE_LIVE=false
# Set to the real HTTPS domain before a public launch. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The included silent montage is enabled by default.
# To replace it, copy your approved MP4 to public/videos/studio.mp4.
# To use another local MP4, uncomment and update this path:
# NEXT_PUBLIC_HERO_VIDEO=/videos/your-video.mp4
# To disable the hero video, uncomment this empty value:
# NEXT_PUBLIC_HERO_VIDEO=
